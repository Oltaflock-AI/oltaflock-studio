{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oltaflock-storage",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "oltaflock-studio" }
  ],
  "routes": [
    { "pattern": "storage-api.oltaflock.ai", "custom_domain": true }
  ],
  "vars": {
    "SUPABASE_URL": "https://xynnkyipiwkvbavquypo.supabase.co",
    "PUBLIC_BASE_URL": "https://cdn.oltaflock.ai",
    "ALLOWED_ORIGINS": "https://studio.oltaflock.ai,http://localhost:8080"
  }
  // Secrets (wrangler secret put): SUPABASE_ANON_KEY, INGEST_SECRET
}
